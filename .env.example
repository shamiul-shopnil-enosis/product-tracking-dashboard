# API
API_PORT=4000
MONGO_URI=mongodb://mongo:27017/product_tracking
# Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
WEB_ORIGIN=http://localhost:3000
UPLOADS_DIR=/data/uploads
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# First admin: created on first start when the users collection is empty (password min 10 chars)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Web (only for running `pnpm dev:web` outside Docker; Docker sets it to the api service)
API_INTERNAL_URL=http://localhost:4000

# Microsoft Clarity Data Export API token (Clarity project > Settings > Data Export). Server only; never commit it.
CLARITY_API_TOKEN=
# Set to false to turn the nightly Clarity sync off (the token can stay set)
CLARITY_SYNC_ENABLED=true

# Google Analytics 4 (Data API). The service account key file goes in ./secrets/ga4.json; never commit it.
GA4_PROPERTY_ID=
GA4_KEY_FILE=/run/secrets/ga4.json
GA4_SYNC_ENABLED=true

# Optional: a Slack/Discord-compatible incoming webhook. Gets a message when a connected data source has not synced for 36 hours.
ALERT_WEBHOOK_URL=
# Sync run logs older than this many days are deleted (minimum 30). Metric history is never deleted.
RETENTION_RUN_DAYS=180
