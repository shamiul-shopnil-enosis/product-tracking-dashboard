# API
API_PORT=4000
MONGO_URI=mongodb://mongo:27017/product_tracking
# Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
WEB_ORIGIN=http://localhost:3000
UPLOADS_DIR=/data/uploads
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
# Sign-in lasts this many hours without activity, and never longer than this many days in total
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# Shown on the sign-in page under "No account?" (an email address or a name). Leave empty to say "Ask your admin".
ACCESS_CONTACT=

# First admin: created on first start when the users collection is empty (password min 10 chars).
# Everyone after that is added on the Users page with a one-time invite link.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Web (only for running `pnpm dev:web` outside Docker; Docker sets it to the api service)
API_INTERNAL_URL=http://localhost:4000

# Microsoft Clarity Data Export API token (Clarity project > Settings > Data Export). Server only; never commit it.
CLARITY_API_TOKEN=
# Set to false to turn the nightly Clarity sync off (the token can stay set)
CLARITY_SYNC_ENABLED=true

# Google Analytics 4 (Data API). The service account key file goes in ./secrets/ga4.json; never commit it.
GA4_PROPERTY_ID=
GA4_KEY_FILE=/run/secrets/ga4.json
GA4_SYNC_ENABLED=true

# Optional: a Slack/Discord-compatible incoming webhook. Gets a message when a connected data source has not synced for 36 hours.
ALERT_WEBHOOK_URL=
# Sync run logs older than this many days are deleted (minimum 30). Metric history is never deleted.
RETENTION_RUN_DAYS=180

# Page speed: Google PageSpeed Insights API key (Google Cloud > APIs & Services > enable "PageSpeed Insights API" > Credentials > API key).
# Required: without a key Google's shared free quota is almost always used up. Free up to 25,000 tests a day.
PAGESPEED_API_KEY=
# Set to false to turn the daily speed check off (the time, 12:00 Bangladesh time by default, is set by an admin on the Core Web Vitals page)
PAGESPEED_SYNC_ENABLED=true
